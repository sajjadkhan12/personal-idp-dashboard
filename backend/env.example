# GitHub OAuth Configuration
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_ORG_NAME=sajjadkhan-academy  # Default GitHub organization name
TEMPLATE_REPO_OWNER=sajjadkhan-academy  # Owner of the template repository
TEMPLATE_REPO_NAME=idp-templates  # Name of the template repository
TEMPLATE_BRANCH=main  # Branch to use for templates
GITHUB_PERSONAL_TOKEN=your-github-personal-access-token  # Token for creating repos and fetching templates

# Terraform Cloud Configuration
TERRAFORM_CLOUD_API_TOKEN=your-terraform-cloud-api-token
TERRAFORM_CLOUD_ORG_NAME=your-terraform-cloud-org
TERRAFORM_CLOUD_REPO=sajjadkhan-academy/terraform-for-idp
TERRAFORM_CLOUD_BRANCH=main
TERRAFORM_CLOUD_WORKING_DIR=terraform-configs
TERRAFORM_CLOUD_TF_VERSION=1.6.0
# Optional: Set this if you know your OAuth token ID, otherwise it will be fetched automatically
TERRAFORM_CLOUD_OAUTH_TOKEN_ID=

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=idp_dashboard
DB_USER=your-postgres-username
DB_PASSWORD=your-postgres-password

# Session Configuration
SESSION_SECRET=your-session-secret-here  # Change this to a random secret string
